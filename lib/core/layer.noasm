DATASEG

PointerArrayId   equ 13
PointerArraySize equ 0
PointerArrayData equ 2

PointerOffset  equ 0
PointerSegment equ 2
PointerSize    equ 4

CODESEG

; ********************************* LAYER / POINTER-ARRAY HELPERS *********************************
proc pushPointer
    push bp
    mov bp, sp
    push bx
    push ax
    push ds

    mov bx, [bp + 6] ; array offset
    mov ds, [bp + 4] ; array segment

    mov ax, [bx + PointerArraySize]
    sal ax, 2

    inc [word ptr bx + PointerArraySize]
    add bx, ax

    add bx, PointerArrayData ; bx -> correct location

    mov ax, [bp + 10] ; pointer offset
    mov [bx + PointerOffset], ax

    mov ax, [bp + 8]  ; pointer segment
    mov [bx + PointerSegment], ax

    pop ds
    pop ax
    pop bx
    pop bp
    ret 8
endp pushPointer


proc swapPointers
    push bp
    mov bp, sp
    push bx
    push ax
    push dx
    push di
    push si
    push ds

    mov bx, [bp + 10] ; bx -> layer offset
    mov ds, [bp + 8]  ; ds -> layer segment
    mov ax, [bp + 6]  ; ax -> index1
    mov dx, [bp + 4]  ; dx -> index2

    add bx, PointerArrayData
    mov si, bx ; si -> start of data
    mov di, bx ; di -> start of data

    sal dx, 2
    add di, dx ; di -> absolute pointer1

    sal ax, 2
    add si, ax ; si -> absolute pointer2

    mov ax, [si + PointerOffset] ; swap offset
    mov bx, [di + PointerOffset]
    mov [si + PointerOffset], bx
    mov [di + PointerOffset], ax

    mov ax, [si + PointerSegment] ; swap segment
    mov bx, [di + PointerSegment]
    mov [si + PointerSegment], bx
    mov [di + PointerSegment], ax
    
    pop ds
    pop si
    pop di
    pop dx
    pop ax
    pop bx
    pop bp
    ret 8
endp swapPointers


proc initAndUploadControllerToLayers
    push bp
    mov bp, sp
    push ax
    push bx
    push cx
    push dx
    push si
    push di

    ; Load controller
    mov bx, [bp + 6]  ; bx -> controller offset
    mov di, [bp + 4]  ; di -> controller segment

    push bx ; controller offset
    push di ; controller segment
    push [bp + 10] ; x
    push [bp + 8]  ; y
    call initController

    mov cx, [bp + 12] ; cx -> amount of lists
    mov ax, cx        ; ax -> amount of lists

    mov si, 14 ; si -> pointer to first list

.loopLists:
    push bx ; controller offset
    push di ; controller segment
    push [bp + si + 2] ; list offset
    push [bp + si]     ; list segment
    call pushPointer

    add si, PointerSize ; Next list
    loop .loopLists

    pop di
    pop si
    pop dx
    pop cx
    pop bx

    ; returning based on the list amount
    cmp ax, 1
    jz .ret1
    cmp ax, 2
    jz .ret2
    cmp ax, 3
    jz .ret3
    cmp ax, 4
    jz .ret4

    pop ax
    pop bp
    ret 10 ; default
.ret1:
    pop ax
    pop bp
    ret 14 ; 1 list
.ret2:
    pop ax
    pop bp
    ret 18 ; 2 lists
.ret3:
    pop ax
    pop bp
    ret 22 ; 3 lists
.ret4:
    pop ax
    pop bp
    ret 26 ; 4 lists
endp initAndUploadControllerToLayers


proc printLayer
    push bp
    mov bp, sp
    push bx
    push cx
    push si
    push ds

    mov si, [bp + 6] ; layer offset
    mov ds, [bp + 4] ; ladyer segment
    mov cx, [ds:si + PointerArraySize] ; layer size

    mov bx, si
    add bx, PointerArrayData

.printBackgroundLoop:
    cmp cx, 0
    je .printBackgroundEnd
    push [ds:bx + PointerOffset]  ; controller pointer
    push [ds:bx + PointerSegment] ; controller segment
    call printControllerBackground
    add bx, PointerSize
    dec cx
    jmp .printBackgroundLoop
.printBackgroundEnd:
    mov cx, [ds:si + PointerArraySize] ; layer size
    mov bx, si
    add bx, PointerArrayData
.saveLoop:
    cmp cx, 0
    je .saveEnd
    push [ds:bx + PointerOffset]  ; controller pointer
    push [ds:bx + PointerSegment] ; controller segment
    call saveControllerBackground
    add bx, PointerSize
    dec cx
    jmp .saveLoop

.saveEnd:
    mov cx, [ds:si + PointerArraySize] ; layer size
    mov bx, si
    add bx, PointerArrayData
.printImageLoop:
    cmp cx, 0
    je .end
    push [ds:bx + PointerOffset]  ; controller pointer
    push [ds:bx + PointerSegment] ; controller segment
    call printController
    add bx, PointerSize
    dec cx
    jmp .printImageLoop
.end:

    pop ds
    pop si
    pop cx
    pop bx
    pop bp
    ret 4
endp printLayer


proc updateAndApplyVelocityLayer
    push bp
    mov bp, sp
    push bx
    push cx
    push ds

    mov bx, [bp + 6] ; bx -> layer offset
    mov ds, [bp + 4] ; ds -> layer segment
    mov cx, [bx + PointerArraySize] ; cx -> size
    add bx, PointerArrayData        ; bx -> start of data

.updateAndApplyLoop:
    cmp cx, 0
    jz .end

    push [bx + PointerOffset]
    push [bx + PointerSegment]
    call updateAndApplyVelocity

    add bx, PointerSize
    dec cx
    jmp .updateAndApplyLoop
.end:

    pop ds
    pop cx
    pop bx
    pop bp
    ret 4
endp updateAndApplyVelocityLayer


proc updateAnimationLayer
    push bp
    mov bp, sp
    push bx
    push cx
    push ds
    push ax

    mov bx, [bp + 8] ; bx -> layer offset
    mov ds, [bp + 6] ; ds -> layer segment
    mov ax, [bp + 4] ; ax -> animation time
    mov cx, [bx + PointerArraySize] ; cx -> size
    add bx, PointerArrayData        ; bx -> start of data

.updateAndApplyLoop:
    cmp cx, 0
    jz .end

    push [bx + PointerOffset]
    push [bx + PointerSegment]
    push ax
    call updateAnimation

    add bx, PointerSize
    dec cx
    jmp .updateAndApplyLoop
.end:

    pop ax
    pop ds
    pop cx
    pop bx
    pop bp
    ret 6
endp updateAnimationLayer


proc clearPointerArray
    push bp
    mov bp, sp
    push bx
    push ds

    mov bx, [bp + 6] ; bx -> array offset
    mov ds, [bp + 4] ; ds -> array segment
    mov [ds:bx + PointerArraySize], 0  ; reset size

    pop ds
    pop bx
    pop bp
    ret 4
endp clearPointerArray


proc getPointerValue
    push bp
    mov bp, sp
    push bx

    mov bx, [bp + 6] ; bx -> pointer offset
    mov ds, [bp + 4] ; ds -> pointer segment

    mov bx, [bx] ; bx -> value
    mov [bp + 6], bx

    pop bx
    pop bp
    ret 2
endp getPointerValue


proc pushPointerToLists
    push bp
    mov bp, sp
    push ax
    push bx
    push cx
    push dx
    push si
    push di

    ; Load controller
    mov bx, [bp + 6]  ; bx -> controller offset
    mov di, [bp + 4]  ; di -> controller segment

    ; Load amount
    mov cx, [bp + 8] ; cx -> list amount
    mov ax, cx       ; ax -> list amount

    ; Where the list entries start
    mov si, 10

.loopLists:
    push bx ; controller offset
    push di ; controller segment
    push [bp + si + 2] ; list offset
    push [bp + si]     ; list segment
    call pushPointer

    add si, PointerSize ; Next list
    loop .loopLists

    pop di
    pop si
    pop dx
    pop cx
    pop bx

    ; returning based on the list amount
    cmp ax, 1
    jz .ret1
    cmp ax, 2
    jz .ret2
    cmp ax, 3
    jz .ret3
    cmp ax, 4
    jz .ret4
    cmp ax, 5
    jz .ret4

    pop ax
    pop bp
    ret 6 ; default
.ret1:
    pop ax
    pop bp
    ret 10 ; 1 list
.ret2:
    pop ax
    pop bp
    ret 14 ; 2 lists
.ret3:
    pop ax
    pop bp
    ret 18 ; 3 lists
.ret4:
    pop ax
    pop bp
    ret 22 ; 4 lists
.ret5:
    pop ax
    pop bp
    ret 26 ; 5 lists
endp pushPointerToLists


proc clearPointerArrays
    push bp
    mov bp, sp
    push ax
    push cx
    push si

    ; Load amount
    mov cx, [bp + 4] ; cx -> list amount
    mov ax, cx       ; ax -> list amount

    ; Where the list entries start
    mov si, 6

.loopLists:
    push [bp + si + 2] ; list offset
    push [bp + si]     ; list segment
    call clearPointerArray

    add si, PointerSize ; Next list
    loop .loopLists

    pop si
    pop cx

    ; returning based on the list amount
    cmp ax, 1
    jz .ret1
    cmp ax, 2
    jz .ret2
    cmp ax, 3
    jz .ret3
    cmp ax, 4
    jz .ret4
    cmp ax, 5
    jz .ret4

    pop ax
    pop bp
    ret 4 ; default
.ret1:
    pop ax
    pop bp
    ret 6 ; 1 list
.ret2:
    pop ax
    pop bp
    ret 10 ; 2 lists
.ret3:
    pop ax
    pop bp
    ret 14 ; 3 lists
.ret4:
    pop ax
    pop bp
    ret 18 ; 4 lists
.ret5:
    pop ax
    pop bp
    ret 22 ; 5 lists
endp clearPointerArrays
