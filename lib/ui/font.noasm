font db FontId
dw 56 ; length
db '0123456789abcdefghijklmnopqrstuvwxyz()*:,$.=!><-%+?"";/ ' ; order of chars
dw offset char0,  seg char0,  offset char1,  seg char1,  offset char2,  seg char2,  offset char3,  seg char3
