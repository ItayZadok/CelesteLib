; integer square root using binary search
; low = 1
; high = number / 2
; while low <= high:
;     mid = (low + high) / 2
;     if mid^2 == number:
;         return mid
;     elif mid^2  < number:
;         low = mid + 1
;     else:
;         high = mid - 1
; return high
proc getSquareRoot
    push bp
    mov bp, sp
    push bx
    push cx
    push si
    push ax
    push dx
    push di

    mov di, [bp + 4] ; di -> number
    mov bx, di
    sar bx, 1        ; bx -> high (number / 2)
    mov cx, 1        ; cx -> low

.squareLoop:
    cmp cx, bx ; while low < high
    jg .end

    mov si, cx
    add si, bx
    shr si, 1 ; si -> mid (low + height) / 2

    mov ax, si ; ax -> mid
    mul si     ; ax -> mid^2

    cmp ax, di ; if (mid^2 == number)
    je .end    ; return mid

    cmp ax, di ; if (mid^2 < number)
    jge .skipHeigh
    mov cx, si
    inc cx     ; cx -> low = mid + 1
    jmp .squareLoop
.skipHeigh:

    mov bx, si
    dec bx ; bx -> high = mid - 1
    jmp .squareLoop

    mov si, bx ; return high
.end:

    mov [bp + 4], si

    pop di
    pop dx
    pop ax
    pop si
    pop cx
    pop bx
    pop bp
    ret
endp getSquareRoot


proc getPower
    push bp
    mov bp, sp
    push ax
    push cx
    push dx
    push di

    mov ax, 1
    mov cx, [bp + 4] ; cx -> power

    cmp cx, 0 ; if power is 0, return 1
    je .end

    mov ax, [bp + 6] ; ax -> base
    mov di, ax       ; di -> base

    dec cx
.powerLoop:
    xor dx, dx
    imul di ; ax -> ax * di
    dec cx
    jnz .powerLoop

.end:
    mov [bp + 6], ax ; return the power

    pop di
    pop dx
    pop cx
    pop ax
    pop bp
    ret 2
endp getPower


; input - x1,y1,x2,y2
; distance = sqrt((x2-x1)^2 + (y2-y1)^2)
proc getDistanceBetweenPoints
    push bp
    mov bp, sp
    push ax
    push bx

    mov bx, [bp + 10] ; x1
    sub bx, [bp + 6]  ; bx -> dx (x1 - x2)
    mov ax, [bp + 8]  ; y1
    sub ax, [bp + 4]  ; ax -> dy (y1 - y2)

    push bx
    push 2
    call getPower
    pop bx ; bx -> dx^2
    
    push ax
    push 2
    call getPower
    pop ax ; ax -> dy^2

    add ax, bx ; ax -> dx^2 + dy^2
    push ax
    call getSquareRoot
    pop ax ; ax -> sqrt(dx^2 + dy^2)

    mov [bp + 10], ax ; return distance

    pop bx
    pop ax
    pop bp
    ret 6
endp getDistanceBetweenPoints


; input - value min max
; returns the clamp of a value by: max(minimum, min(x, maximum))
proc clamp
    push bp
    mov bp, sp
    push ax

    push [bp + 6] ; min

    push [bp + 8] ; value
    push [bp + 4] ; max
    call min
    call max
    pop ax
    mov [bp + 8], ax

    pop ax
    pop bp
    ret 4
endp clamp


proc min
    push bp
    mov bp, sp
    push bx
    push dx

    mov bx, [bp + 4] ; value1
    mov dx, [bp + 6] ; value2

    cmp bx, dx
    jg .end
    mov dx, bx
.end:
    mov [bp + 6], dx

    pop dx
    pop bx
    pop bp
    ret 2
endp min


proc max
   push bp
    mov bp, sp
    push bx
    push dx

    mov bx, [bp + 4] ; value1
    mov dx, [bp + 6] ; value2

    cmp bx, dx
    jl .end
    mov dx, bx
.end:
    mov [bp + 6], dx

    pop dx
    pop bx
    pop bp
    ret 2
endp max


proc getAbs
    push bp
    mov bp, sp
    push ax
    mov ax, [bp + 4]
    cmp ax, 0    ; check if positive
    jge .end     ; if greater than or equal to 0, jump to end
    neg ax       ; negate to get the absolute value
.end:
    mov [bp + 4], ax
    pop ax
    pop bp
    ret
endp getAbs


proc inRange
    push bp
    mov bp, sp
    push ax

    mov ax, [bp + 4] ; value

    cmp ax, [bp + 8] ; if value < min
    jl .false

    cmp ax, [bp + 6]  ; if value > max
    jg .false

    mov ax, 1   ; return true
    jmp .end

.false:
    xor ax, ax
.end:
    mov [bp + 8], ax
    pop ax
    pop bp
    ret 4
endp inRange


proc getSin
    push bp
    mov bp, sp
    push bx
    push es
    push ax

    mov bx, [bp + 4] ; rotation

    cmp bx, 180
    jge .negative

    add bx, offset sin_table
    mov ax, seg sin_table
    mov es, ax

    mov bl, [es:bx]
    xor bh, bh

    jmp .end
.negative:

    add bx, offset sin_table
    mov ax, seg sin_table
    mov es, ax

    mov bl, [es:bx]
    xor bh, bh

    neg bx

.end:
    mov [bp + 4], bx

    pop ax
    pop es
    pop bx
    pop bp
    ret
endp getSin


proc getCos
    push bp
    mov bp, sp
    push bx
    push es
    push ax

    mov bx, [bp + 4] ; rotation

    cmp bx, 270
    jge .positive

    cmp bx, 90
    jle .positive

    add bx, offset cos_table
    mov ax, seg cos_table
    mov es, ax

    mov bl, [es:bx]
    xor bh, bh

    neg bx

    jmp .end
.positive:

    add bx, offset cos_table
    mov ax, seg cos_table
    mov es, ax

    mov bl, [es:bx]
    xor bh, bh

.end:
    mov [bp + 4], bx

    pop ax
    pop es
    pop bx
    pop bp
    ret
endp getCos


proc getInverseClamp
    push bp
    mov bp, sp
    push ax
    push bx
    push cx

    mov ax, [bp + 8] ; ax -> value
    mov bx, [bp + 6] ; bx -> min
    mov cx, [bp + 4] ; cx -> max

    cmp ax, bx ; value < min return max
    jg .retMin

    mov ax, cx
    jmp .end
.retMin:
    cmp ax, cx ; value > max return min
    jl .end

    mov ax, bx
.end:
    mov [bp + 8], ax

    pop cx
    pop bx
    pop ax
    pop bp
    ret 4
endp getInverseClamp


proc getSign
    push bp
    mov bp, sp
    push ax

    cmp [bp + 4], 0
    jnz .isNotZero
    mov ax, 0
    jmp .end
.isNotZero:

    cmp [bp + 4], 0
    jg .isPositive

    mov ax, -1
    jmp .end
.isPositive:
    mov ax, 1

.end:
    mov [bp + 4], ax
    pop ax
    pop bp
    ret
endp getSign


proc getMinAbs
   push bp
    mov bp, sp
    push bx
    push dx

    mov bx, [bp + 4] ; value1
    mov dx, [bp + 6] ; value2

    push bx
    call getAbs
    pop bx
    
    push dx
    call getAbs
    pop dx

    cmp bx, dx
    jg .end
    mov dx, bx
.end:
    mov [bp + 6], dx

    pop dx
    pop bx
    pop bp
    ret 2
endp getMinAbs

proc getMaxAbsIndex
    push bp
    mov bp, sp
    push bx
    push dx

    mov bx, [bp + 4] ; value1
    mov dx, [bp + 6] ; value2

    push bx
    call getAbs
    pop bx
    
    push dx
    call getAbs
    pop dx

    cmp bx, dx
    jl .continue
    mov dx, 1
    jmp .end
.continue:
    mov dx, 0
.end:
    mov [bp + 6], dx

    pop dx
    pop bx
    pop bp
    ret 2
endp getMaxAbsIndex

proc getMinAbsIndex
    push bp
    mov bp, sp
    push bx
    push dx

    push [bp + 6] ; value1
    call getAbs
    pop dx

    push [bp + 4] ; value2
    call getAbs
    pop bx
    
    cmp bx, dx ; value1
    jg .continue
    mov dx, 1
    jmp .end
.continue:
    mov dx, 0
.end:
    mov [bp + 6], dx

    pop dx
    pop bx
    pop bp
    ret 2
endp getMinAbsIndex

proc getMaxAbs
    push bp
    mov bp, sp
    push bx
    push dx

    mov bx, [bp + 4] ; value1
    mov dx, [bp + 6] ; value2

    push bx
    call getAbs
    pop bx
    
    push dx
    call getAbs
    pop dx

    cmp bx, dx
    jl .end
    mov dx, bx
.end:
    mov [bp + 6], dx

    pop dx
    pop bx
    pop bp
    ret 2
endp getMaxAbs

proc multiply
    push bp
    mov bp, sp
    push ax
    push dx
    push cx

    mov ax, [bp + 6] ; ax -> num1
    mov cx, [bp + 4] ; cx -> num2

    xor dx, dx
    imul cx
    mov [bp + 6], ax ; return num1 * num2

    pop cx
    pop dx
    pop ax
    pop bp
    ret 2
endp multiply

proc divideModulo
    push bp
    mov bp, sp
    push ax
    push dx

    mov ax, [bp + 6]

    cwd
    idiv [bp + 4]
    mov [bp + 4], ax ; /
    mov [bp + 6], dx ; %

    pop dx
    pop ax
    pop bp
    ret
endp divideModulo

proc divide
    push bp
    mov bp, sp
    push ax
    push dx
    push cx

    mov ax, [bp + 6]

    cwd
    idiv [bp + 4]
    mov [bp + 6], ax

    pop cx
    pop dx
    pop ax
    pop bp
    ret 2
endp divide
